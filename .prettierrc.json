{
  "$schema": "https://json.schemastore.org/prettierrc",
  "printWidth": 100,
  "useTabs": false,
  "semi": true,
  "tabWidth": 2,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "jsxSingleQuote": false,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "auto",
  "vueIndentScriptAndStyle": true
}
